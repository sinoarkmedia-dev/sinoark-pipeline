# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Gemini (for source profiling, translation, labeling) — gemini-2.0-flash
GEMINI_API_KEY=AIza...

# Container base URLs (local)
# C1 has 212 feeds (primary), C2/C3 have 178 each (redundancy)
CONTAINER_C1_URL=http://localhost:8001
CONTAINER_C2_URL=http://localhost:8004
CONTAINER_C3_URL=http://localhost:8003

# Container SQLite DB paths (on this server)
CONTAINER_C1_DB=/root/data/db.db
CONTAINER_C2_DB=/root/data2/db.db
CONTAINER_C3_DB=/root/data3/db.db
